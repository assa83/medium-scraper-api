{
  "name": "Apify medium-scraper (daily digest to Google Sheets)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 8
            }
          ]
        }
      },
      "id": "8946fed5-3868-472e-9bb5-f0e46bbdbdf9",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/lagenuina_agency~medium-scraper/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"tags\": [\n    \"rag\",\n    \"llm\"\n  ],\n  \"maxItemsPerFeed\": 20,\n  \"includeContent\": false\n}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "46f80b3d-84de-4baf-8af4-7e7f47a0ed03",
      "name": "Run Apify actor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Apify API token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// One row per article.\nreturn $input.all().map(({ json }) => ({ json: { publishedAt: json.publishedAt, title: json.title, author: json.author, claps: json.claps, responses: json.responses, readingTime: json.readingTimeMinutes, memberOnly: json.isPaywalled, tags: (json.tags ?? []).join(', '), url: json.url } }));"
      },
      "id": "4f6715f8-ea8d-4611-a045-5d9612fec6ba",
      "name": "Pick columns",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_GOOGLE_SHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Sheet1"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "3f6328bd-044b-463e-af20-7db392f9e662",
      "name": "Append to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        720,
        0
      ]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Run Apify actor",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Apify actor": {
      "main": [
        [
          {
            "node": "Pick columns",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pick columns": {
      "main": [
        [
          {
            "node": "Append to Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "active": false
}